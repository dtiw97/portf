---
import { site } from "../data/site";

const onHome = Astro.url.pathname === "/";
const href = (hash: string) => (onHome ? hash : `/${hash}`);
---

<header class="header">
  <div class="wrap bar">
    <a href="/" class="mark" aria-label={`${site.name}, home`}>
      <img class="hanzi" src="/favicon.svg" alt="" width="32" height="32" />
      <span class="name">{site.name}</span>
    </a>
    <nav aria-label="Primary">
      <a href={href("#work")}>Work</a>
      <a href={href("#stack")}>Stack</a>
      <a href={href("#contact")}>Contact</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: linear-gradient(var(--color-bg) 40%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .mark {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .hanzi {
    width: 2rem;
    height: 2rem;
  }

  .name {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  nav {
    display: flex;
    gap: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  nav a {
    transition: color var(--dur-fast);
  }

  nav a:hover {
    color: var(--color-text);
  }

  @media (max-width: 560px) {
    .name {
      display: none;
    }
    nav {
      gap: var(--space-4);
    }
  }
</style>
